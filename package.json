{
  "name": "aico-ppt-skill",
  "version": "0.1.0",
  "description": "AICO-PPT Agent Skill 与 DeepSeek Harness 可视化 Editor 插件",
  "private": true,
  "type": "module",
  "main": "integrations/dsh/index.mjs",
  "exports": {
    ".": "./integrations/dsh/index.mjs",
    "./client": "./integrations/dsh/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workbench"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test:dsh-plugin": "node --test integrations/dsh/tests/*.test.mjs",
    "test:editor:unit": "node scripts/run-editor-tests.mjs unit",
    "test:editor:e2e": "node scripts/run-editor-tests.mjs e2e",
    "test:editor:python": "node scripts/run-editor-tests.mjs python",
    "test:editor": "node scripts/run-editor-tests.mjs all"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "html2canvas": "1.4.1",
    "playwright-core": "^1.62.1",
    "three": "^0.185.1",
    "ws": "8.21.1"
  },
  "optionalDependencies": {
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "1.2.0-beta.15"
  }
}
